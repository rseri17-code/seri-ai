NEXT_PUBLIC_SITE_URL=https://seri-ai.vercel.app
NEXT_PUBLIC_CANONICAL_DOMAIN=seri-ai.vercel.app
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-latest

# Preview-only Ask synthesizer. none (default) keeps retrieval plus the current local/OpenAI/Anthropic path.
# groq requires GROQ_API_KEY. Default model is openai/gpt-oss-120b
# (llama-3.3-70b-versatile was shut down 2026-08-16 and is aliased).
# ollama requires OLLAMA_BASE_URL. Never expose these to the client.
ASK_LLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

ADMIN_TOKEN=change-me

# Durable /api/ask rate limit. Set either Vercel KV or Upstash REST.
# When both are empty, Ask uses a per-instance memory window (20 requests / minute).
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
